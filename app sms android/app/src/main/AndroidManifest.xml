<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="tech.bogomolov.incomingsmsgateway">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- La Bomba 2.7.0 (Guardian). Permisos nuevos, todos de nivel normal (no piden dialogo al usuario):
         WAKE_LOCK: mantener la CPU despierta con el servicio y el Wi-Fi activo (WakeLock y WifiLock).
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: abrir el dialogo de Android «sin restriccion de bateria».
         SCHEDULE_EXACT_ALARM (solo Android 12 y 12L): alarma exacta cada ~5 min del segundo vigilante.
         USE_EXACT_ALARM (Android 13+): lo mismo, concedido al instalar. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- La Bomba 2.9.0 (orden de Emil, 25 nov 2026: todos los permisos posibles para el telefono dedicado, Android 16).
         Cada uno tiene un uso real en la app:
         ACCESS_WIFI_STATE: señal, velocidad y frecuencia del Wi-Fi en el latido. CHANGE_WIFI_STATE y CHANGE_NETWORK_STATE: la app figura en
         «control de Wi-Fi» de HONOR y puede pedir/soltar redes (Android 10+ no deja a una app encender o apagar el Wi-Fi, con o sin este permiso).
         ACCESS_FINE/COARSE/BACKGROUND_LOCATION: Android exige ubicacion para entregar el nombre del Wi-Fi; la app NO lee la ubicacion del telefono.
         READ_PHONE_STATE: estado exacto de la SIM y de la red movil. PACKAGE_USAGE_STATS: cubeta de espera real y ultima vez que Android uso la app.
         SYSTEM_ALERT_WINDOW: permite abrir la pantalla de la app desde segundo plano. WRITE_SETTINGS: ajustes del sistema que Android deja cambiar a una app.
         ACCESS_NOTIFICATION_POLICY: no molestar. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- La Bomba 2.10.0 (pantalla remota propia). WRITE_SECURE_SETTINGS no lo da ningun boton de Android: solo sirve si el dueño
         lo concede UNA vez por adb (pm grant ... android.permission.WRITE_SECURE_SETTINGS). Con el, la app activa sola el servicio
         de accesibilidad de pantalla remota (Guardian.autoActivarPantalla). Sin el, no pasa nada: se activa a mano en Ajustes. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- La Bomba 2.11.0. USE_EXACT_ALARM ya está declarada arriba (alarma exacta del vigilante, concedida al instalar en Android 13+;
         el app va por instalación directa, no por Play). El despertar por FCM no pide permisos propios: firebase-messaging
         aporta WAKE_LOCK y el permiso de C2DM, y INTERNET ya está. -->

    <!-- La Bomba 2.12.0 (actualizacion automatica). REQUEST_INSTALL_PACKAGES: Android no deja que una app confirme sesiones del instalador
         sin el; ademas, para actualizarse sin pantalla de confirmacion (Android 12+, USER_ACTION_NOT_REQUIRED) hace falta que «Instalar apps
         desconocidas» este permitido para esta app (appops REQUEST_INSTALL_PACKAGES allow, una vez por adb, o el interruptor en Ajustes). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Visibilidad de paquetes (Android 11+): saber que existe el instalador del sistema al que apunta el intent de confirmacion. -->
    <queries>
        <intent>
            <action android:name="android.content.pm.action.CONFIRM_INSTALL" />
        </intent>
    </queries>

    <application
        android:name=".LaBombaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <!-- 2.11.0: despertar por FCM (mensaje solo de datos, prioridad alta). No exportado: solo lo llama Firebase. -->
        <service
            android:name=".DespertarFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".SmsReceiverService"
            android:enabled="true"
            android:exported="true" />

        <!--
            SMS delivery is driven by this manifest-declared receiver, not by a
            receiver registered at runtime inside SmsReceiverService. SMS_RECEIVED
            is on the implicit-broadcast allowlist, so a manifest receiver still
            fires on Android 8+ and, crucially, the system cold-starts the process
            to deliver it even after the foreground service has been killed by an
            aggressive OEM battery manager (issue #78). The android:permission
            guard ensures only the system (holder of BROADCAST_SMS) can trigger it,
            so another app cannot spoof fake SMS into the forwarder.
        -->
        <receiver
            android:name=".SmsBroadcastReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- La Bomba 2.7.0: tambien LOCKED_BOOT_COMPLETED, MY_PACKAGE_REPLACED y QUICKBOOT_POWERON.
             directBootAware solo para poder recibir LOCKED_BOOT_COMPLETED; el receptor no toca nada
             mientras el usuario no haya desbloqueado el telefono. -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 2.9.0: ancla de supervivencia (acceso a notificaciones). Android la mantiene enlazada y la revive sola.
             No lee notificaciones. Solo actúa si la persona da el acceso en Ajustes. -->
        <service
            android:name=".GuardianListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 2.10.0: pantalla remota propia. Servicio de accesibilidad: captura la pantalla y ejecuta toques SOLO mientras hay una
             sesion abierta en el visor web y las ordenes llegan firmadas. No lee el contenido de las ventanas. -->
        <service
            android:name=".PantallaRemotaService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pantalla_remota_config" />
        </service>

        <!-- 2.12.0: resultado de la sesion de PackageInstaller de la actualizacion automatica. No exportado: solo lo llama el PendingIntent
             explicito de la propia app. -->
        <receiver
            android:name=".ActualizacionReceptor"
            android:exported="false" />

        <!-- Segundo vigilante: solo lo dispara la alarma que la propia app programa. -->
        <receiver
            android:name=".GuardianAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Modo telefono dedicado (opcional): sin efecto salvo que el dueño ejecute dpm set-device-owner. -->
        <receiver
            android:name=".GuardianAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".HealthActivity"
            android:exported="false"
            android:label="@string/health_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>